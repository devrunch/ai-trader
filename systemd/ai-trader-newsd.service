# The news engine (app/worker/newsd.py). Capped and expendable by design: an
# LLM pass over the hourly batch is the only thing here that can grow without
# warning, and it must not be able to take the terminal down with it.
[Unit]
Description=AI Trader news engine
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-trader/ai-trader-signals
EnvironmentFile=/home/ubuntu/ai-trader/ai-trader-signals/.env
Environment=PYTHONUNBUFFERED=1
Environment=NUMBA_DISABLE_JIT=1
# Last, and therefore the winner over anything stale in the .env above:
# systemd applies EnvironmentFile= after Environment=, and this is where
# deploy.sh writes the loopback addresses of the other services.
EnvironmentFile=-/home/ubuntu/ai-trader/.deploy-state/public.env
ExecStart=/home/ubuntu/ai-trader/venv-signals/bin/python -m app.worker.newsd
Restart=always
# A crash loop here would hammer the LLM and the news vendors; an hourly job
# can afford to wait half a minute.
RestartSec=30
# Hard cap, no swap: the process dies rather than pushing the terminal into
# swap, and systemd restarts it for the next hour's run.
MemoryMax=350M
MemorySwapMax=0
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
